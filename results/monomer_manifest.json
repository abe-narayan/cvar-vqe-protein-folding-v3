      "relaxation": "native rebuild <= 0.7 A instead of 0.5 A",
      "would_give": 59,
      "gain": 7,
      "cost": "0.7 A of the reported RMSD is then representation error the search can never remove -- a floor, not a result."
    },
    {
      "relaxation": "NMR entries with >= 2 models instead of >= 5",
      "would_give": 52,
      "gain": 0,
      "cost": "spread stops being an estimate of anything with 2 models; single-model NMR entries carry no uncertainty information at all."
    },
